<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(SenseMicPackagesDir)Microsoft.Windows.SDK.CPP.$(SenseMicWdkVersion)\build\native\Microsoft.Windows.SDK.cpp.targets"
          Condition="Exists('$(SenseMicPackagesDir)Microsoft.Windows.SDK.CPP.$(SenseMicWdkVersion)\build\native\Microsoft.Windows.SDK.cpp.targets')" />
  <Target Name="SenseMicEnsureWdkNuGet" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(SenseMicPackagesDir)Microsoft.Windows.WDK.x64.$(SenseMicWdkVersion)\build\native\Microsoft.Windows.WDK.x64.props')"
           Text="Restore packages.config before building SenseMicVAD (run driver/windows/build-driver.ps1)." />
  </Target>
</Project>
