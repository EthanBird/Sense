<Window
    x:Class="Sense.Settings.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Sense 先思输入法"
    Width="1160"
    Height="780"
    MinWidth="960"
    MinHeight="680"
    Background="{StaticResource CanvasBrush}"
    FontFamily="Segoe UI Variable Text, Microsoft YaHei UI"
    Foreground="{StaticResource TextBrush}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border
            Grid.Column="0"
            Background="#0D1422"
            BorderBrush="{StaticResource StrokeBrush}"
            BorderThickness="0,0,1,0">
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="36" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Border
                        Width="42"
                        Height="42"
                        Background="#123B4A"
                        CornerRadius="13">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="24"
                            FontWeight="Bold"
                            Foreground="{StaticResource AccentBrush}"
                            Text="S" />
                    </Border>
                    <StackPanel Margin="12,1,0,0">
                        <TextBlock
                            FontSize="19"
                            FontWeight="SemiBold"
                            Text="Sense" />
                        <TextBlock
                            Margin="0,2,0,0"
                            FontSize="12"
                            Foreground="{StaticResource MutedBrush}"
                            Text="先思输入法 · Windows" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <TextBlock
                        Margin="8,0,0,12"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="#64748B"
                        Text="WORKSPACE" />
                    <Border
                        Padding="12,10"
                        Background="#15293A"
                        CornerRadius="10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Width="26"
                                FontSize="15"
                                Foreground="{StaticResource AccentBrush}"
                                Text="⌨" />
                            <TextBlock FontWeight="SemiBold" Text="输入与候选" />
                        </StackPanel>
                    </Border>
                    <Border Margin="0,5,0,0" Padding="12,10" CornerRadius="10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Width="26"
                                FontSize="15"
                                Foreground="{StaticResource MutedBrush}"
                                Text="✦" />
                            <TextBlock Foreground="{StaticResource MutedBrush}" Text="AI Agent 通道" />
                        </StackPanel>
                    </Border>
                    <Border Margin="0,5,0,0" Padding="12,10" CornerRadius="10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Width="26"
                                FontSize="15"
                                Foreground="{StaticResource MutedBrush}"
                                Text="⌘" />
                            <TextBlock Foreground="{StaticResource MutedBrush}" Text="Skills 与快捷键" />
                        </StackPanel>
                    </Border>
                    <Border Margin="0,5,0,0" Padding="12,10" CornerRadius="10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Width="26"
                                FontSize="15"
                                Foreground="{StaticResource MutedBrush}"
                                Text="◫" />
                            <TextBlock Foreground="{StaticResource MutedBrush}" Text="词库与数据" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border
                    Grid.Row="3"
                    Padding="14"
                    Background="#111C2D"
                    BorderBrush="{StaticResource StrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <StackPanel>
                        <TextBlock
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource AccentBrush}"
                            Text="ARCHITECTURE" />
                        <TextBlock
                            Margin="0,7,0,0"
                            FontSize="12"
                            Foreground="{StaticResource MutedBrush}"
                            Text="逐键解码留在 TSF 进程内；Provider、Skills 与工具只走进程外桥接。"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <ScrollViewer
            Grid.Column="1"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <Grid Margin="42,32,42,46">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,26">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock
                            FontSize="30"
                            FontWeight="SemiBold"
                            Text="输入，先于智能发生" />
                        <TextBlock
                            Margin="0,8,0,0"
                            FontSize="14"
                            Foreground="{StaticResource MutedBrush}"
                            Text="原生 TSF 中文输入 · 本地 SPLX 解码 · Agent 能力按需唤醒" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <Border
                            Padding="10,6"
                            Background="#102D31"
                            BorderBrush="#1B5B63"
                            BorderThickness="1"
                            CornerRadius="999">
                            <TextBlock
                                FontSize="11"
                                FontWeight="Bold"
                                Foreground="{StaticResource AccentBrush}"
                                Text="{Binding RegistrationBadge}" />
                        </Border>
                        <Border
                            Margin="8,0,0,0"
                            Padding="10,6"
                            Background="#102D31"
                            BorderBrush="#1B5B63"
                            BorderThickness="1"
                            CornerRadius="999">
                            <TextBlock
                                FontSize="11"
                                FontWeight="Bold"
                                Foreground="{StaticResource AccentBrush}"
                                Text="{Binding DictionaryBadge}" />
                        </Border>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource PositiveBrush}"
                                Text="SYSTEM STATUS" />
                            <TextBlock
                                Margin="0,8,0,0"
                                FontSize="19"
                                FontWeight="SemiBold"
                                Text="{Binding InstallationSummary}" />
                            <TextBlock
                                Margin="0,7,0,0"
                                FontSize="13"
                                Foreground="{StaticResource MutedBrush}"
                                Text="Ctrl + Space 切换中英文；1–5 选词；Enter 提交原始拼音；Esc 取消组合。"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            Margin="28,0,0,0"
                            VerticalAlignment="Center"
                            Command="{Binding OpenDataCommand}"
                            Content="打开数据目录"
                            Style="{StaticResource SecondaryButtonStyle}" />
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource AccentBrush}"
                            Text="01 · INPUT CORE" />
                        <TextBlock
                            Margin="0,7,0,18"
                            FontSize="21"
                            FontWeight="SemiBold"
                            Text="输入与本地候选" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="15" FontWeight="SemiBold" Text="启动时默认中文模式" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontSize="12"
                                    Foreground="{StaticResource MutedBrush}"
                                    Text="写入本地原生配置投影；逐键路径仍只读取内存状态。" />
                            </StackPanel>
                            <CheckBox
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                IsChecked="{Binding DefaultChineseMode}"
                                Style="{StaticResource SenseToggleStyle}" />
                        </Grid>

                        <Border Height="1" Margin="0,17" Background="{StaticResource StrokeBrush}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="15" FontWeight="SemiBold" Text="中文标点联动" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontSize="12"
                                    Foreground="{StaticResource MutedBrush}"
                                    Text="组合中输入逗号、句号、问号时一次事务提交候选和标点。" />
                            </StackPanel>
                            <CheckBox
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                IsChecked="{Binding UseChinesePunctuation}"
                                Style="{StaticResource SenseToggleStyle}" />
                        </Grid>

                        <TextBlock
                            Margin="0,24,0,9"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource MutedBrush}"
                            Text="候选条预览" />
                        <Border
                            Padding="13,10"
                            Background="#111827"
                            BorderBrush="#334155"
                            BorderThickness="1"
                            CornerRadius="12">
                            <StackPanel>
                                <TextBlock
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="#94A3B8"
                                    Text="SENSE  ·  nihaoshijie" />
                                <Border Height="1" Margin="0,8,0,7" Background="#334155" />
                                <StackPanel Orientation="Horizontal">
                                    <Border Padding="10,7" Background="#0E7490" CornerRadius="7">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Margin="0,0,8,0" Foreground="#67E8F9" Text="1" />
                                            <TextBlock FontSize="16" Text="你好世界" />
                                        </StackPanel>
                                    </Border>
                                    <StackPanel Margin="17,7,0,0" Orientation="Horizontal">
                                        <TextBlock Margin="0,0,8,0" Foreground="#67E8F9" Text="2" />
                                        <TextBlock FontSize="16" Text="你好，世界" />
                                    </StackPanel>
                                    <StackPanel Margin="22,7,0,0" Orientation="Horizontal">
                                        <TextBlock Margin="0,0,8,0" Foreground="#67E8F9" Text="3" />
                                        <TextBlock FontSize="16" Text="你号世界" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Row="3" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource AccentBrush}"
                                    Text="02 · AGENT LANE" />
                                <TextBlock
                                    Margin="0,7,0,5"
                                    FontSize="21"
                                    FontWeight="SemiBold"
                                    Text="AI Agent 进程外通道" />
                                <TextBlock
                                    FontSize="13"
                                    Foreground="{StaticResource MutedBrush}"
                                    Text="保留 editor snapshot、Skill revision、流式事件与 patch 回写 ABI；Provider 不进入 TSF DLL。"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <CheckBox
                                Grid.Column="1"
                                Margin="28,0,0,0"
                                VerticalAlignment="Center"
                                IsChecked="{Binding AgentEnabled}"
                                Style="{StaticResource SenseToggleStyle}" />
                        </Grid>

                        <Grid Margin="0,22,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock
                                    Margin="0,0,0,7"
                                    FontSize="12"
                                    Foreground="{StaticResource MutedBrush}"
                                    Text="OpenAI-compatible endpoint" />
                                <TextBox
                                    IsEnabled="{Binding AgentEnabled}"
                                    Text="{Binding ProviderEndpoint, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock
                                    Margin="0,0,0,7"
                                    FontSize="12"
                                    Foreground="{StaticResource MutedBrush}"
                                    Text="模型" />
                                <TextBox
                                    IsEnabled="{Binding AgentEnabled}"
                                    Text="{Binding ProviderModel, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    Foreground="{StaticResource MutedBrush}"
                                    Text="唤醒快捷键" />
                                <TextBox
                                    Width="180"
                                    Margin="12,0,0,0"
                                    IsEnabled="{Binding AgentEnabled}"
                                    Text="{Binding AgentHotkey, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,0,12,0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    Foreground="{StaticResource MutedBrush}"
                                    Text="随 Windows 启动桥接进程" />
                                <CheckBox
                                    VerticalAlignment="Center"
                                    IsChecked="{Binding StartAgentWithWindows}"
                                    IsEnabled="{Binding AgentEnabled}"
                                    Style="{StaticResource SenseToggleStyle}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="4" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource AccentBrush}"
                            Text="03 · SKILLS" />
                        <TextBlock
                            Margin="0,7,0,18"
                            FontSize="21"
                            FontWeight="SemiBold"
                            Text="为桌面输入预留的四个起点" />
                        <UniformGrid Columns="4">
                            <Border Margin="0,0,8,0" Padding="14" Background="#0D1727" CornerRadius="12">
                                <StackPanel>
                                    <TextBlock FontSize="18" Foreground="{StaticResource AccentBrush}" Text="↘" />
                                    <TextBlock Margin="0,10,0,3" FontWeight="SemiBold" Text="精简" />
                                    <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}" Text="rewrite.concise" />
                                </StackPanel>
                            </Border>
                            <Border Margin="3,0,5,0" Padding="14" Background="#0D1727" CornerRadius="12">
                                <StackPanel>
                                    <TextBlock FontSize="18" Foreground="{StaticResource AccentBrush}" Text="✎" />
                                    <TextBlock Margin="0,10,0,3" FontWeight="SemiBold" Text="润色" />
                                    <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}" Text="rewrite.polish" />
                                </StackPanel>
                            </Border>
                            <Border Margin="5,0,3,0" Padding="14" Background="#0D1727" CornerRadius="12">
                                <StackPanel>
                                    <TextBlock FontSize="18" Foreground="{StaticResource AccentBrush}" Text="文" />
                                    <TextBlock Margin="0,10,0,3" FontWeight="SemiBold" Text="翻译" />
                                    <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}" Text="translate" />
                                </StackPanel>
                            </Border>
                            <Border Margin="8,0,0,0" Padding="14" Background="#0D1727" CornerRadius="12">
                                <StackPanel>
                                    <TextBlock FontSize="18" Foreground="{StaticResource AccentBrush}" Text="…" />
                                    <TextBlock Margin="0,10,0,3" FontWeight="SemiBold" Text="续写" />
                                    <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}" Text="continue" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="5" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{StaticResource MutedBrush}"
                        Text="{Binding SaveStatus}" />
                    <Button
                        Grid.Column="1"
                        Command="{Binding SaveCommand}"
                        Content="保存设置"
                        Style="{StaticResource PrimaryButtonStyle}" />
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
